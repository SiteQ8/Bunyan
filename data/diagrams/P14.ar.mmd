flowchart RL
  U["المستخدم"] --> ORC["طبقة التنسيق<br/>حواجز حماية المدخلات"]
  ORC -- "هوية المستخدم" --> RET["الاسترجاع<br/>بصلاحيات المستخدم فقط"]
  RET --> KB["مخزن المعرفة"]
  ORC <--> LLM["النموذج"]
  ORC -- "استدعاءات محددة ومفوَّضة" --> TOOLS["الأدوات<br/>وظائف مسموح بها فقط"]
  TOOLS -- "إجراء عالي المخاطر" --> HIL["موافقة بشرية"]
  ORC --> OUT["فحص المخرجات<br/>الترميز والترشيح"]
  OUT --> U
  ORC --> LOG["سجلات التعليمات والمصادر<br/>واستدعاءات الأدوات"]
