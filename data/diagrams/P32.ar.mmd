flowchart RL
  C["العميل يبدأ دفعة<br/>في المتصفح"] --> SRV["خدمة المدفوعات"]
  SRV -- "المبلغ والمستفيد" --> APP["تطبيق البنك على الجهاز المسجل"]
  APP -- "العميل يراجع التفاصيل" --> KEY["مفتاح محمي بالعتاد<br/>يوقّع المبلغ والمستفيد"]
  KEY -- "التوقيع" --> SRV
  SRV --> VER["إعادة البناء والتحقق<br/>والرفض عند اختلاف التفاصيل"]
  VER --> RISK["رقابة الاحتيال<br/>إيقاف المدفوعات غير المعتادة"]
  RISK --> CORE["نظام المدفوعات الأساسي"]
  VER --> REC["سجل موقّع<br/>للنزاعات"]
