flowchart RL
  DISC["اكتشاف من الخارج<br/>النطاقات والشهادات والعناوين"] --> INV["حصر الأصول<br/>مع المالكين"]
  REG["الأصول المسجلة"] --> INV
  INV --> SCAN["فحص مستمر<br/>الأجهزة والسحابة والشيفرة"]
  SCAN --> PRI["تحديد الأولويات"]
  KEV["قائمة الثغرات المستغلة"] --> PRI
  EPSS["احتمال الاستغلال"] --> PRI
  PRI -- "مواعيد تقاس بالأيام" --> FIX["إصلاح أو تخفيف"]
  FIX --> VER["إعادة فحص أو اختبار موجّه"]
  VER -- "ما زالت مفتوحة" --> PRI
  VER --> MET["تقرير الاتجاه<br/>للقيادة"]
