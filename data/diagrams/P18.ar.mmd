flowchart RL
  EXT["المرسلون على الإنترنت"] --> AUTH["التحقق من المرسل<br/>SPF, DKIM, DMARC"]
  AUTH --> FILT["فلترة البريد<br/>البرمجيات الضارة والانتحال"]
  FILT --> SBX["بيئة معزولة للمرفقات"]
  SBX --> MBX["صناديق البريد<br/>مع تعليم البريد الخارجي"]
  MBX -- "النقر" --> LNK["فحص الروابط<br/>لحظة النقر"]
  MBX -- "زر الإبلاغ" --> SOC["مركز العمليات الأمنية<br/>والحذف الآلي"]
  COL["المحادثات والملفات المشتركة"] --> GUEST["نطاقات خارجية معتمدة<br/>ودخول الضيوف"]
  GUEST --> SOC
  PAY["طلب تغيير بيانات الدفع"] -- "اتصال تأكيد على رقم معروف" --> FIN["اعتماد الإدارة المالية"]
