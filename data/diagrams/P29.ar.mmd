flowchart RL
  U["المستخدم"] --> AG["وكيل الذكاء الاصطناعي"]
  SRC["البريد والمستندات وصفحات الويب<br/>مدخلات غير موثوقة"] --> AG
  AG -- "استدعاء برمز المستخدم" --> GW["بوابة الأدوات<br/>السياسة والحدود والمعدلات"]
  GW -- "مسموح" --> TL["أدوات ضيقة<br/>قراءة سجل أو صياغة رد"]
  GW -- "إجراء لا رجعة فيه أو عالي القيمة" --> HUM["شخص يعتمد<br/>الإجراء بالضبط"]
  HUM --> TL
  TL -- "نتائج مفحوصة" --> AG
  REG["أدوات وخوادم معتمدة<br/>بإصدارات مثبتة"] --> GW
  GW -- "التعليمات والاستدعاءات والنتائج" --> LOG["السجلات ونظام إدارة السجلات"]
