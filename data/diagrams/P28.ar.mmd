flowchart RL
  REQ["المتطلبات الأمنية<br/>ونمذجة التهديدات"] --> DEV["المطور"]
  DEV -- "قبل الإيداع" --> SEC["فحص الأسرار"]
  SEC --> PR["طلب الدمج"]
  PR --> SAST["التحليل الثابت"]
  PR --> SCA["تحليل الاعتماديات"]
  PR --> IAC["فحص شيفرة البنية التحتية"]
  SAST --> GATE["بوابة الدمج<br/>تمنع ما يهم"]
  SCA --> GATE
  IAC --> GATE
  GATE --> BUILD["البناء والنشر للاختبار"]
  BUILD --> DAST["الفحص الديناميكي<br/>والاختبارات الموجّهة"]
  DAST --> REL["الإطلاق"]
  GATE -- "البقية" --> BL["قائمة العمل بمدد الإصلاح"]
