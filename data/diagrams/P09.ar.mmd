flowchart RL
  CLS["نظام التصنيف<br/>أربعة مستويات"] --> INV["سجل حصر البيانات<br/>أين توجد كل فئة"]
  INV --> RULES["قواعد التعامل لكل مستوى"]
  RULES --> ENC["التشفير أثناء النقل والتخزين"]
  RULES --> MASK["الإخفاء والاستبدال الرمزي<br/>قبل خروج البيانات من الإنتاج"]
  RULES --> DLP["منع تسرب البيانات<br/>البريد والويب والأجهزة والخدمات السحابية"]
  RULES --> RET["الاحتفاظ والحذف"]
  RULES --> MON["مراقبة الوصول<br/>إلى المخازن المقيدة"]
