flowchart RL
  U["المستخدمون أينما كانوا<br/>على أجهزة مُدارة"] --> AG["وكيل الحافة"]
  AG --> SSE["حافة الخدمات الأمنية"]
  SSE --> SWG["بوابة الويب الآمنة<br/>الفلترة والتنزيلات"]
  SSE --> CASB["وسيط أمن الوصول إلى السحابة<br/>الخدمات المعتمدة فقط"]
  SSE --> DLP["قواعد موحدة لمنع التسرب<br/>الرفع والنماذج والتعليمات"]
  SSE --> ZTNA["الوصول إلى التطبيقات الخاصة"]
  SWG --> WEB["الويب"]
  CASB --> SAAS["الخدمات السحابية الجاهزة"]
  ZTNA --> PRIV["التطبيقات الخاصة"]
  SSE -- "السجلات" --> SOC["مركز العمليات الأمنية"]
