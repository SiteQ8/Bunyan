flowchart RL
  DIR["الدليل<br/>ومزود الهوية"] -- "التذاكر والنسخ وتغييرات المجموعات والرموز" --> SIEM["نظام إدارة السجلات<br/>قواعد كشف الهوية"]
  PATH["رسم مسارات الهجوم"] --> FIX["إزالة المسارات الخطرة<br/>والتفويض والثقة القديمة"]
  FIX --> DIR
  DEC["حسابات وبيانات اعتماد<br/>خادعة"] --> SIEM
  SIEM -- "هجوم على الهوية" --> PB["أدلة الاحتواء"]
  PB --> ACT["تعطيل الحسابات وإلغاء الرموز<br/>وإعادة تعيين مفتاح منح التذاكر مرتين"]
  ACT --> DIR
  BK["نسخ احتياطية غير متصلة للدليل<br/>وإعادة بناء مُختبَرة"] --> DIR
