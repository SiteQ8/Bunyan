flowchart RL
  SYS["الأنظمة والأجهزة الطرفية<br/>وأعباء العمل السحابية"] -- "سجلات بساعات متزامنة" --> PIPE["مسار السجلات"]
  PIPE --> EVI["مخزن الأدلة<br/>حساب منفصل وكتابة مرة واحدة"]
  PIPE --> SIEM["نظام إدارة السجلات والكشف"]
  SIEM -- "حادثة" --> IR["فريق الاستجابة للحوادث"]
  IR --> CAP["صور الذاكرة والأقراص<br/>واللقطات السحابية"]
  CAP --> EVI
  IR --> OOB["قناة تواصل بديلة"]
  IR --> EXT["عقود التحقيق الجنائي<br/>والاستشارات القانونية"]
  IR --> REGU["إبلاغ الجهة الرقابية<br/>ضمن المهلة"]
  IR -- "الدروس المستفادة" --> DES["التصميم والضوابط"]
