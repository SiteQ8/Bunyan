flowchart RL
  PART["الشريك"] -- "مفاتيحه الخاصة وقناة مشفرة" --> EX["منصة تبادل مُدارة<br/>في منطقتها الخاصة"]
  EX --> Q["منطقة العزل"]
  Q --> SCAN["فحص البرمجيات الضارة<br/>والتحقق من الصيغة"]
  SCAN --> CDR["إعادة بناء المستندات الخطرة"]
  CDR --> SIG["التحقق من التواقيع<br/>وقيم التحقق"]
  SIG --> CORE["الأنظمة الداخلية"]
  CORE -- "ملفات صادرة موقّعة" --> EX
  EX -- "من وماذا ومتى وقيمة التجزئة" --> LOG["سجل النقل ونظام إدارة السجلات"]
  AGR["اتفاقية الشريك<br/>البيانات والقناة والمفاتيح وجهات التواصل"] --> EX
