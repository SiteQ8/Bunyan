flowchart RL
  DEV["جهاز الشركة<br/>مشفر ومحدّث"] --> MDM["إدارة الأجهزة<br/>خط الأساس والحصر"]
  DEV --> EDR["وكيل الكشف والاستجابة<br/>محمي من العبث"]
  EDR --> SOC["مركز العمليات الأمنية<br/>يعزل خلال دقائق"]
  MDM -- "مؤشر الالتزام" --> IDP["مزود الهوية"]
  IDP -- "مُدار وسليم" --> APPS["التطبيقات الحساسة"]
  BYOD["جهاز شخصي"] -- "عبر المتصفح فقط" --> IDP
  ALLOW["قوائم سماح للتطبيقات<br/>على الأجهزة الحساسة"] --> DEV
  PAW["محطات عمل مخصصة<br/>للمسؤولين"] --> APPS
