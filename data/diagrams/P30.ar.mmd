flowchart RL
  CLS["بيانات مصنفة<br/>حسب الإقامة"] --> MAP["خريطة الإقامة<br/>المناطق والخدمات والميزات"]
  MAP --> POL["ضوابط المناطق<br/>ورفض ما سواها"]
  POL --> REG["المنطقة المحلية المعتمدة"]
  KMS["مفاتيح تحتفظ بها أنت<br/>وحدة أمن محلية أو مدير مفاتيح خارجي"] --> REG
  PROV["موظفو المزود"] -- "وصول معتمد ومسجل فقط" --> REG
  REG --> CHK["فحص مستمر<br/>لموقع البيانات الفعلي"]
  REG -- "نسخ قابلة للاستعادة" --> EXIT["موقع أو مزود ثانٍ<br/>وخروج مُختبَر"]
