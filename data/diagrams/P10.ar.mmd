flowchart RL
  SRC["المصادر<br/>الهوية والأجهزة الطرفية والسحابة<br/>وأسماء النطاقات والوكيل والتطبيقات"] --> PIPE["المسار<br/>التحليل والإثراء وتوحيد التوقيت"]
  PIPE --> SIEM["نظام إدارة السجلات<br/>أو بحيرة بيانات أمنية<br/>ضمن نطاق ثقة منفصل"]
  SIEM --> DET["قواعد كشف بوصفها شيفرة<br/>مربوطة بأساليب المهاجمين"]
  DET --> SOAR["أتمتة الاستجابة<br/>وأدلة الاستجابة"]
  SOAR --> ACT["الاحتواء والتعطيل والحجب"]
  SIM["محاكاة الهجمات"] -. "تختبر" .-> DET
