flowchart RL
  C["العميل وجهازه"] --> APP["تطبيق الويب أو الهاتف"]
  APP --> CIAM["خدمة هوية العملاء<br/>مفاتيح المرور أولًا"]
  CIAM -- "مؤشرات الدخول والإجراءات" --> RISK["محرك تقييم المخاطر"]
  RISK -- "سماح أو إثبات أقوى أو منع" --> CIAM
  BP["فحص كلمات المرور المسربة"] --> CIAM
  REC["الاستعادة وتغيير بيانات التواصل<br/>أقوى عنصر ومدة تهدئة"] --> CIAM
  CIAM --> TOK["جلسات قصيرة<br/>مرتبطة بالجهاز"]
  TOK --> API["واجهات الحسابات والمدفوعات"]
  CIAM -- "أحداث الهوية" --> FRAUD["رقابة الاحتيال<br/>ونظام إدارة السجلات"]
