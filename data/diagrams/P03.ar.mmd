flowchart RL
  A["المسؤول"] --> PAW["محطة عمل مخصصة للصلاحيات الهامة<br/>دون بريد ودون تصفح"]
  PAW --> PAM["بوابة إدارة الصلاحيات الهامة<br/>عند الحاجة ومع التسجيل"]
  APPR["موافقة للطبقة الصفرية"] --> PAM
  PAM --> T0["الطبقة الصفرية<br/>الهوية والشهادات ولوحات النسخ الاحتياطي"]
  PAM --> T1["الطبقة الأولى<br/>الخوادم والتطبيقات"]
  PAM --> T2["الطبقة الثانية<br/>أجهزة المستخدمين"]
  PAM --> LOG["سجلات الجلسات وتسجيلاتها<br/>إلى نظام إدارة السجلات"]
  BG["حسابات الطوارئ<br/>مغلقة وتُطلق تنبيهًا"] -.-> T0
