flowchart RL
  DEV["المطور"] -- "تغيير مُراجَع" --> REPO["المستودع<br/>حماية الفروع وفحص الأسرار"]
  REPO --> CI["مشغّل بناء مؤقت<br/>اعتماديات مثبّتة الإصدار"]
  DEPS["وكيل الحزم<br/>حزم موثوقة"] --> CI
  CI --> ART["مُخرَج موقّع<br/>قائمة المكونات وإثبات المصدر"]
  ART --> REG["سجل المخرجات"]
  REG --> ADM["سياسة النشر<br/>التحقق من التوقيع والمصدر"]
  ADM --> PROD["بيئة الإنتاج"]
